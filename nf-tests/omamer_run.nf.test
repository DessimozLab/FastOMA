nextflow_process {

    name "Test Process omamer_run"
    script "../FastOMA.nf"
    process "omamer_run"
    tag "process"
    tag "omamer_run"

    test("omamer_run: runs omamer search when no precomputed hogmap is available") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        file("${projectDir}/testdata/in_folder/proteome/AQUAE.fa"),
                        file("${projectDir}/testdata/test.h5"),
                        file("${projectDir}/nf-tests/helpers/empty_hogmap_in"),
                        "ready"
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
            def hogmap = path(process.out[0][0])
            assert hogmap.fileName.toString() == "AQUAE.fa.hogmap"
            // a freshly computed hogmap carries a real omamer version tag, not our fixture marker
            assert hogmap.text.contains("!omamer-version:")
            assert !hogmap.text.contains("precomputed-fixture-marker")
        }
    }

    test("omamer_run: reuses a precomputed hogmap instead of re-running omamer") {

        when {
            process {
                """
                input[0] = Channel.of(
                    tuple(
                        file("${projectDir}/testdata/in_folder/proteome/AQUAE.fa"),
                        file("${projectDir}/testdata/test.h5"),
                        file("${projectDir}/nf-tests/helpers/precomputed_hogmap_in"),
                        "ready"
                    )
                )
                """
            }
        }

        then {
            assert process.success
            assert process.out[0].size() == 1
            def hogmap = path(process.out[0][0])
            assert hogmap.fileName.toString() == "AQUAE.fa.hogmap"
            // the precomputed fixture is copied verbatim, not regenerated by omamer
            assert hogmap.text.contains("precomputed-fixture-marker")
        }
    }

}
