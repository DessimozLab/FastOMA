nextflow_pipeline {

    name "Test pipeline FastOMA with non-default options"
    script "../FastOMA.nf"
    tag "pipeline"
    tag "pipeline_options"

    test("id transformer, MSA/gene tree output and disabled scores") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                msa_folder = "$outputDir/msa"
                genetrees_folder = "$outputDir/genetrees"
                fasta_header_id_transformer = "UniProt"
                write_msas = true
                write_genetrees = true
                // all scores disabled; the report (on in the test profile) must still be produced
                disable_completeness_score = true
                disable_implied_losses_score = true
                disable_tcs_score = true
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def orthoxml = out.resolve('FastOMA_HOGs.orthoxml')
            def orthoxml_text = orthoxml.text
            def roothogs = FastomaOutput.groupPartition(out.resolve('RootHOGs.tsv'))

            assertAll(
                { assert workflow.success },
                // UniProt transformer: "sp|P13927|EFTU_MYCGE" -> "P13927" in all outputs
                { assert roothogs.flatten().every { it ==~ /[A-Z0-9]{6,10}/ } },
                { assert FastomaOutput.canonicalHogs(orthoxml).every { !it.contains('|') } },
                { assert !orthoxml_text.contains('CompletenessScore') },
                { assert out.resolve('report.html').toFile().exists() },
                { assert !orthoxml_text.contains('ImpliedLosses') },
                { assert !orthoxml_text.contains('TCSScore') },
                { assert file("${params.msa_folder}").list().size() > 0 },
                { assert file("${params.genetrees_folder}").list().size() > 0 },
                { assert snapshot(
                    roothogs,
                    FastomaOutput.groupPartition(out.resolve('OrthologousGroups.tsv')),
                    FastomaOutput.pairs(out.resolve('orthologs.tsv.gz')),
                ).match() }
            )
        }
    }

    test("archive input with precomputed hogmaps") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                hogmap_folder = "$outputDir/hogmap"
                input = "${projectDir}/nf-tests/helpers/input_archive.tar.gz"
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def hogmaps = file("${params.hogmap_folder}").listFiles().findAll { it.name.endsWith('.hogmap') }

            assertAll(
                { assert workflow.success },
                { assert hogmaps.size() == 3 },
                // the precomputed hogmaps from the archive are used, omamer is not re-run
                { assert hogmaps.every { it.text.contains('precomputed-fixture-marker') } },
                { assert snapshot(
                    FastomaOutput.groupPartition(out.resolve('RootHOGs.tsv')),
                    FastomaOutput.canonicalHogs(out.resolve('FastOMA_HOGs.orthoxml')),
                ).match() }
            )
        }
    }

    test("archive made with macOS tar (AppleDouble ._ files)") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                hogmap_folder = "$outputDir/hogmap"
                // same content as input_archive.tar.gz, plus a ._<name> metadata file for every entry
                input = "${projectDir}/nf-tests/helpers/input_archive_macos.tar.gz"
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def hogmap_files = file("${params.hogmap_folder}").listFiles()
            def species = FastomaOutput.speciesNames(out.resolve('FastOMA_HOGs.orthoxml'))

            assertAll(
                { assert workflow.success },
                // the hidden files are neither taken as proteomes nor passed to omamer
                { assert hogmap_files.findAll { it.name.startsWith('.') }.isEmpty() },
                { assert hogmap_files.findAll { it.name.endsWith('.hogmap') }.size() == 3 },
                { assert species == ['AQUAE', 'CHLTR', 'MYCGE'] },
            )
        }
    }

    test("input whose proteome folder is a symlink") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                hogmap_folder = "$outputDir/hogmap"
                // proteome/ and species_tree.nwk are symlinks to testdata/in_folder (#83)
                input = "${projectDir}/nf-tests/helpers/symlinked_input"
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def hogmaps = file("${params.hogmap_folder}").listFiles().findAll { it.name.endsWith('.hogmap') }

            assertAll(
                { assert workflow.success },
                // before #83, the proteome channel was empty: only check_input ran
                { assert hogmaps.size() == 3 },
                { assert FastomaOutput.speciesNames(out.resolve('FastOMA_HOGs.orthoxml')) == ['AQUAE', 'CHLTR', 'MYCGE'] },
            )
        }
    }

    test("proteome folder without fasta files fails") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                // contains only a hidden .gitkeep
                proteome_folder = "${projectDir}/nf-tests/helpers/empty_splice_in"
            }
        }

        then {
            assert !workflow.success
            assert (workflow.stdout + workflow.stderr).any { it.contains("No proteome files (*.fa or *.fasta) found") }
        }
    }

    test("splice files select one isoform per gene") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                // AQUAE.splice declares EFTU_AQUAE and LEPA_AQUAE as isoforms of one gene
                splice_folder = "${projectDir}/nf-tests/helpers/splice_in"
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def orthoxml = out.resolve('FastOMA_HOGs.orthoxml')
            def referenced = FastomaOutput.geneRefCounts(orthoxml).keySet()
            def isoforms = ['sp|O66429|EFTU_AQUAE', 'sp|O67618|LEPA_AQUAE']

            assertAll(
                { assert workflow.success },
                // exactly one isoform of the gene ends up in the HOGs
                { assert referenced.intersect(isoforms).size() == 1 },
                { assert orthoxml.text.contains('main_isoform=') },
                { assert snapshot(
                    FastomaOutput.groupPartition(out.resolve('RootHOGs.tsv')),
                    FastomaOutput.canonicalHogs(orthoxml),
                ).match() }
            )
        }
    }

    test("de-novo clustering without OMAmer") {

        when {
            params {
                outdir = "$outputDir"
                output_folder = "$outputDir"
                hogmap_folder = "$outputDir/hogmap"
                denovo = true
                // must not be used: neither staged nor checked
                omamer_db = "${projectDir}/does_not_exist.h5"
            }
        }

        then {
            def out = file(params.output_folder).toPath()
            def orthoxml = out.resolve('FastOMA_HOGs.orthoxml')
            def families = (orthoxml.text =~ /name="OMAmerRootHOG" value="([^"]+)"/).collect { it[1] }
            def roothogs = FastomaOutput.groupPartition(out.resolve('RootHOGs.tsv'))

            assertAll(
                { assert workflow.success },
                // omamer did not run
                { assert !file("${params.hogmap_folder}").exists() },
                { assert !workflow.trace.tasks().any { it.name.startsWith('omamer_run') } },
                // all rootHOGs come from the mmseqs clustering
                { assert families && families.every { it.startsWith('HOG:clust') } },
                // the conserved single-copy families are found
                { assert roothogs.contains(['sp|O67118|DNAK_AQUAE', 'sp|P17821|DNAK_CHLTR', 'sp|P47547|DNAK_MYCGE']) },
                { assert roothogs.contains(['sp|O67032|RF1_AQUAE', 'sp|O84026|RF1_CHLTR', 'sp|P47500|RF1_MYCGE']) },
            )
        }
    }
}
